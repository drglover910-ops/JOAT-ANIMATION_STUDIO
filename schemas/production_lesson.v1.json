{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "joat.production_lesson.v1",
  "file_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "file_version", "id", "status", "roles", "scope", "title", "guidance", "review", "evidence", "valid_from", "expires_at", "versions", "supersedes"],
  "properties": {
    "schema": {"const": "joat.production_lesson.v1"},
    "file_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "status": {"enum": ["candidate", "approved", "superseded", "rejected"]},
    "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["main", "executive", "browser", "hugging_face", "narration", "character", "environment", "director", "shot_camera", "performance_action", "generation_supervisor", "generation_worker", "quality_control", "post_production", "editorial", "sound", "music", "compositing_vfx", "color_finish", "titles_graphics", "voice_dialogue", "delivery_archive"]}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["project_id", "style_id"], "properties": {"project_id": {"type": ["string", "null"]}, "style_id": {"type": ["string", "null"]}}},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "guidance": {"type": "string", "minLength": 1, "maxLength": 4000},
    "review": {"type": "object", "required": ["reviewer", "approval_basis"], "properties": {"reviewer": {"type": "string", "minLength": 1}, "approval_basis": {"type": "string", "minLength": 1}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source", "sha256"], "properties": {"source": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
